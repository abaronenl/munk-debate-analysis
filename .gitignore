# ============================================================
# Research data
#
# Raw copyrighted material, generated intermediate transcripts,
# and processed research outputs remain local.
#
# data/metadata/ is intentionally NOT ignored because manifests
# and source metadata should be version controlled.
# ============================================================

data/raw/**
data/interim/**
data/processed/**


# Keep empty data directories in the repository
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep